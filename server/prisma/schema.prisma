generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  name         String
  role         String     @default("CUSTOMER") // "CUSTOMER" or "ADMIN"
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  orders       Order[]
  reviews      Review[]
  wishlists    Wishlist[]
}

model Category {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  description String?
  image       String?
  products    Product[]
}

model Product {
  id            String      @id @default(uuid())
  title         String
  slug          String      @unique
  description   String
  price         Float
  discountPrice Float?
  stock         Int         @default(0)
  categoryId    String
  category      Category    @relation(fields: [categoryId], references: [id])
  images        String      // JSON string array of image URLs
  specs         String      // JSON key-value object of specs (e.g. {"GPU": "RTX 4080", "RAM": "32GB"})
  isFeatured    Boolean     @default(false)
  rating        Float       @default(4.8)
  reviewCount   Int         @default(0)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  orderItems    OrderItem[]
  reviews       Review[]
  wishlists     Wishlist[]
}

model Order {
  id              String      @id @default(uuid())
  orderNumber     String      @unique
  userId          String?
  user            User?       @relation(fields: [userId], references: [id])
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String      // JSON string with address, city, state, postalCode
  status          String      @default("Pending") // Pending, Confirmed, Processing, Shipped, Delivered
  paymentMethod   String      // "UPI_SIMULATED", "CARD_SIMULATED", "COD"
  paymentStatus   String      @default("PAID")
  totalAmount     Float
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  items           OrderItem[]
}

model OrderItem {
  id        String  @id @default(uuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  title     String
  price     Float
  quantity  Int
  image     String
}

model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
}
